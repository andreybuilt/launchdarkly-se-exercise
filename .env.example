# Copy this file to .env and fill in real values. .env is gitignored and
# must never be committed. The values below are placeholders only.

# Server-side SDK key: LaunchDarkly > Project settings > Environments >
# <env> > SDK key. Read by server/ldClient.mjs. Required to run `npm start`
# against real LaunchDarkly data.
LD_SDK_KEY=sdk-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Client-side ID: same page, Project settings > Environments > <env> >
# Client-side ID. Served to the browser at runtime via GET /config.js,
# never hard-coded in the bundle.
LD_CLIENT_SIDE_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Used only by scripts/setup-launchdarkly.mjs, scripts/setup-experiment.mjs
# and scripts/setup-ai-config.mjs: a personal or service access token with
# write access to the project, from Organization settings > Authorization.
# Used to create the demo flags, targets, rules, metric, experiment and AI
# Config via the REST API. Not needed to run the app itself, only to
# provision it.
LD_API_TOKEN=api-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Project and environment keys used by the setup scripts above. Defaults
# shown here match the scripts' own defaults.
LD_PROJECT_KEY=default
LD_ENV_KEY=test

# Printed by scripts/setup-launchdarkly.mjs after it creates the
# remediation trigger. It is a real, per-project URL, so there is no usable
# placeholder here; left commented out so `source .env` never exports a
# fake one. Copy what the script prints into this line, uncomment it, and
# treat it as a secret (anyone with it can flip the flag). Used by
# scripts/remediate.sh.
# LD_TRIGGER_URL=https://app.launchdarkly.com/webhook/triggers/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
#
# Alternative to the line above: scripts/remediate.sh also accepts the URL
# from a file, named by LD_TRIGGER_URL_FILE (default ./trigger_url, which
# is gitignored). Useful to keep the URL off a shared screen or shell
# history; set either this or LD_TRIGGER_URL above, not both.
# LD_TRIGGER_URL_FILE=./trigger_url

# Port the Express server listens on. Optional, defaults to 8080.
PORT=8080

# Extra credit: AI Configs. Base URL of an OpenAI-compatible chat
# completions endpoint. LLM_BASE_URL is the preferred name; OLLAMA_BASE_URL
# is kept as a fallback for a local Ollama install. Read by
# server/aiChat.mjs. Optional, defaults to http://localhost:11434 (Ollama's
# default).
LLM_BASE_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434

# Extra credit: AI Configs. Optional API key for a hosted OpenAI-compatible
# provider, used instead of a local Ollama install. When set, it is sent as
# "Authorization: Bearer <key>" and never logged. Leave unset for Ollama,
# which does not require one.
# LLM_API_KEY=
